cmake_minimum_required(VERSION 3.24)
project(@GAME_TARGET@ C CXX)

# Locate nova-engine on every configure: -DNOVA_ENGINE_DIR=<path> if given (clear it with
# -DNOVA_ENGINE_DIR=), else the NOVA_ENGINE_DIR environment variable, else the checkout recorded
# when this game was created. Every build compiles the engine's current source.
set(NOVA_ENGINE_DIR "" CACHE PATH "nova-engine checkout to use (empty: $NOVA_ENGINE_DIR, else the default)")
if(NOVA_ENGINE_DIR)
    set(_nova_engine "${NOVA_ENGINE_DIR}")
elseif(NOT "$ENV{NOVA_ENGINE_DIR}" STREQUAL "")
    set(_nova_engine "$ENV{NOVA_ENGINE_DIR}")
else()
    set(_nova_engine "${CMAKE_CURRENT_SOURCE_DIR}/@ENGINE_REL_PATH@")
endif()
if(NOT EXISTS "${_nova_engine}/cmake/Nova.cmake")
    message(FATAL_ERROR "nova-engine not found at '${_nova_engine}'. Clone it there, or configure with "
                        "-DNOVA_ENGINE_DIR=<path> (or set the NOVA_ENGINE_DIR environment variable).")
endif()
include("${_nova_engine}/cmake/Nova.cmake")

nova_add_game(@GAME_TARGET@
    SOURCES
        src/main.cpp
        src/scenes/title_scene.cpp
    ASSETS assets
    BUNDLE_ID @BUNDLE_ID@
    DISPLAY_NAME "@GAME_NAME@"
    ORIENTATION @ORIENTATION@
    VERSION 1.0.0      # shown in the stores
    BUILD_NUMBER 1)    # bump for every store upload

# Game-logic tests (desktop only): ctest --preset macos-debug
nova_add_game_tests(@GAME_TARGET@ SOURCES tests/test_game.cpp)
