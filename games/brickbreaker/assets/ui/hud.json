{
  // In-game HUD: a row across the top, kept clear of the notch.
  "type": "panel", "width": "fill", "layout": "row", "align": "center", "gap": 16,
  "safeArea": true, "padding": [12, 24, 0, 24],
  "children": [
    { "type": "label", "id": "score", "style": "hud", "text": "Score 0", "width": "fill" },
    { "type": "label", "id": "level", "style": "hud-muted", "text": "Level 1", "width": "fill", "textAlign": "center" },
    { "type": "label", "id": "lives", "style": "hud", "text": "Lives 3", "width": "fill", "textAlign": "right" },
    { "type": "button", "id": "pause", "style": "icon", "text": "II", "width": 96, "height": 96 }
  ]
}
