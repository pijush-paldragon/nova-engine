{
  "type": "panel", "width": 720, "height": 1280, "anchor": "center", "layout": "column", "align": "center",
  "padding": [360, 0, 0, 0], "gap": 16, "enter": "fade",
  "children": [
    { "type": "label", "style": "title-pink", "text": "@gameover.title", "maxWidth": 680, "overflow": "shrink" },
    { "type": "label", "id": "score", "style": "body", "text": "@gameover.score" },
    { "type": "label", "id": "best", "style": "muted", "text": "@gameover.best" },
    { "type": "panel", "height": 160 },
    { "type": "button", "id": "again", "style": "primary", "text": "@gameover.again", "width": 360, "overflow": "shrink" },
    { "type": "button", "id": "menu", "style": "secondary", "text": "@gameover.menu", "width": 360, "overflow": "shrink" }
  ]
}
