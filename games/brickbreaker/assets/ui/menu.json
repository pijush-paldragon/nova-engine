{
  // Title screen, laid out on the 720x1280 design area (centred on any screen), so it lines up
  // with the decorative brick row the scene draws at y = 700.
  "type": "panel", "width": 720, "height": 1280, "anchor": "center", "layout": "column", "align": "center",
  "padding": [290, 0, 0, 0], "enter": "fade",
  "children": [
    { "type": "label", "style": "title", "text": "BRICK" },
    { "type": "label", "style": "title-gold", "text": "BREAKER" },
    { "type": "label", "id": "best", "style": "muted", "text": "Best: 0" },
    { "type": "panel", "height": 210 },
    { "type": "button", "id": "play", "style": "primary", "text": "Play", "width": 360 },
    { "type": "panel", "height": 24 },
    { "type": "button", "id": "settings", "style": "secondary", "text": "Settings", "width": 360 }
  ]
}
